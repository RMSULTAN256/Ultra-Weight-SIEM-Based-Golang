# Salin file ini menjadi .env (file .env TIDAK di-commit) lalu isi nilainya.
#   cp .env.example .env && chmod 600 .env
#
# 1) JWT_SECRET = kunci tanda tangan token login. WAJIB, minimal 32 karakter.
#    Server menolak start (log.Fatal) kalau kosong / kurang dari 32 karakter.
#    Buat dengan: openssl rand -hex 32
JWT_SECRET=

# 2) AGENT_API_KEY = kunci bersama untuk endpoint agen (/api/v1/agent/*).
#    Nilai yang sama harus dipasang di sisi Agent (header X-Agent-Key).
#    Buat dengan: openssl rand -hex 16
AGENT_API_KEY=

# 3) Opsional: password akun "admin" saat database pertama kali dibuat.
#    Kalau dikosongkan, server membuat password acak dan mencetaknya ke log:
#    [AUTH SEED] Akun default dibuat: Username: admin | Password: ... (Role: admin)
ADMIN_INIT_PASSWORD=
