{
    "scan_interval_ms": 500,
    "scan_interval": 5,
    "targets": [
        {
            "app_name": "Nginx Web",
            "file_path": "/var/log/nginx/*.log",
            "keywords": []
        },
        {
            "app_name": "Apache Web",
            "file_path": "/var/log/apache2/*.log",
            "keywords": []
        },
        {
            "app_name": "SSH Auth",
            "file_path": "/var/log/auth.log",
            "keywords": []
        },
        {
            "app_name": "System Syslog",
            "file_path": "/var/log/syslog",
            "keywords": []
        },
        {
            "app_name": "Kernel",
            "file_path": "/var/log/kern.log",
            "keywords": [
                "ufw block",
                "out of memory",
                "oom-kill",
                "segfault"
            ]
        },
        {
            "app_name": "UFW Firewall",
            "file_path": "/var/log/ufw.log",
            "keywords": []
        },
        {
            "app_name": "MySQL Database",
            "file_path": "/var/log/mysql/*.log",
            "keywords": []
        },
        {
            "app_name": "MariaDB Database",
            "file_path": "/var/log/mariadb/*.log",
            "keywords": []
        },
        {
            "app_name": "PostgreSQL Database",
            "file_path": "/var/log/postgresql/*.log",
            "keywords": []
        },
        {
            "app_name": "Web Application",
            "file_path": "/var/www/*/storage/logs/*.log",
            "keywords": []
        },
        {
            "app_name": "Package Management",
            "file_path": "/var/log/dpkg.log",
            "keywords": [
                " install ",
                " remove "
            ]
        },
        {
            "app_name": "Fail2ban",
            "file_path": "/var/log/fail2ban.log",
            "keywords": [
                " ban ",
                " unban "
            ]
        }
    ]
}
